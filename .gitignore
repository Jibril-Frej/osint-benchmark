# Corpora and generated questions are never committed: they are large, and the
# source licences differ per corpus.
data/
*.jsonl
*.jsonl.gz

# pins/ is committed: it is how a rebuilder checks their corpora against the ones the
# benchmark was built on. Nothing in it is large -- one line per source.
!pins/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Agent instructions and notes: local working context, not part of the benchmark.
.claude/
CLAUDE.md
AGENTS.md
releases/

# Credentials never belong here -- this repository is public. Tokens live outside it,
# in ~/.config/hf-token, and the cluster jobs read them from there.
*token*
*.secret
.env
