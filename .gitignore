# Corpora and generated questions are never committed: they are large, and the
# source licences differ per corpus.
data/
*.jsonl
*.jsonl.gz

# The pins are the exception: small, and the point of them is that they are committed —
# they are how a rebuilder checks their corpus against the one the benchmark was built on.
!pins/hashes/*.jsonl

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Agent instructions and notes: local working context, not part of the benchmark.
.claude/
CLAUDE.md
AGENTS.md
